{
  "name": "votewise",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "db:push": "prisma db push --accept-data-loss --schema=./server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.19.2"
  }
}
