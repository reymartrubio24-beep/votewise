{
  "name": "votewise",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "prisma generate --schema=./server/prisma/schema.prisma && npm run build --workspace=client"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.19.2"
  }
}
